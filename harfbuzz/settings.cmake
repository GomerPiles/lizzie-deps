# Initial cache for the upstream core HarfBuzz library and Lizzie's target ABIs.
set(CMAKE_BUILD_TYPE Release CACHE STRING "")
set(CMAKE_POSITION_INDEPENDENT_CODE ON CACHE BOOL "")
set(CMAKE_INSTALL_LIBDIR lib CACHE STRING "")

# Use HarfBuzz's own Unicode data and shapers. The client only needs the core
# package; optional integrations and the other HarfBuzz libraries stay out.
foreach(feature CAIRO CORETEXT DIRECTWRITE FREETYPE GDI GLIB GOBJECT GRAPHITE2 ICU INTROSPECTION UNISCRIBE)
    set(HB_HAVE_${feature} OFF CACHE BOOL "")
endforeach()
foreach(component GPU RASTER SUBSET UTILS VECTOR)
    set(HB_BUILD_${component} OFF CACHE BOOL "")
endforeach()
set(HB_BUILD_GPU_DEMO OFF CACHE STRING "")

if(LIZZIE_TARGET STREQUAL "x86_64-windows")
    # A C ABI DLL serves both the native MSVC and MinGW cross builds. Keep the
    # MSVC runtime in the DLL. The upstream CMake minimum predates CMP0091.
    set(BUILD_SHARED_LIBS ON CACHE BOOL "")
    set(CMAKE_POLICY_DEFAULT_CMP0091 NEW CACHE STRING "")
    set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreaded CACHE STRING "")
    set(CMAKE_C_FLAGS "/DWIN32 /D_WINDOWS /arch:AVX2" CACHE STRING "")
    set(CMAKE_CXX_FLAGS "/DWIN32 /D_WINDOWS /arch:AVX2" CACHE STRING "")
else()
    set(BUILD_SHARED_LIBS OFF CACHE BOOL "")
    if(LIZZIE_TARGET STREQUAL "aarch64-macos")
        set(CMAKE_OSX_ARCHITECTURES arm64 CACHE STRING "")
        set(CMAKE_OSX_DEPLOYMENT_TARGET 26.0 CACHE STRING "")
        set(cpu apple-m1)
    elseif(LIZZIE_TARGET MATCHES "^(x86_64|aarch64)-linux-gnu$")
        set(arch "${CMAKE_MATCH_1}")
        if(arch STREQUAL "x86_64")
            set(cpu x86_64_v3)
        else()
            set(cpu generic+v8_2a)
        endif()
        set(CMAKE_SYSTEM_NAME Linux CACHE STRING "")
        set(CMAKE_SYSTEM_PROCESSOR "${arch}" CACHE STRING "")
        set(CMAKE_C_COMPILER "${CMAKE_CURRENT_LIST_DIR}/zig/cc" CACHE FILEPATH "")
        set(CMAKE_CXX_COMPILER "${CMAKE_CURRENT_LIST_DIR}/zig/c++" CACHE FILEPATH "")
        set(CMAKE_AR "${CMAKE_CURRENT_LIST_DIR}/zig/ar" CACHE FILEPATH "")
        set(CMAKE_RANLIB "${CMAKE_CURRENT_LIST_DIR}/zig/ranlib" CACHE FILEPATH "")
        foreach(lang C CXX)
            set(CMAKE_${lang}_COMPILER_TARGET "${arch}-linux-gnu.2.28" CACHE STRING "")
        endforeach()
        set(LIZZIE_LINK_LIBRARIES "m pthread" CACHE STRING "")
    else()
        message(FATAL_ERROR "Unknown HarfBuzz target: ${LIZZIE_TARGET}")
    endif()
    foreach(lang C CXX)
        set(CMAKE_${lang}_FLAGS "-mcpu=${cpu} -fstack-protector-strong" CACHE STRING "")
        set(CMAKE_${lang}_FLAGS_RELEASE "-O3 -DNDEBUG -g0" CACHE STRING "")
    endforeach()
endif()
