# Linux CI image: Ubuntu 24.04 from a pinned snapshot, Weston 13 and lavapipe for
# Wayland and rendering checks, and Node with Playwright's headless Chromium for browser
# tests. Built natively per architecture.
# ubuntu:noble-20250805 multi-architecture index.
FROM docker.io/library/ubuntu@sha256:9cbed754112939e914291337b5e554b07ad7c392491dba6daf25eef1332a22e8
ARG TARGETARCH
# The snapshot service intermittently answers 503; every apt download below retries.
RUN ["sh", "-c", "echo 'Acquire::Retries \"8\";' > /etc/apt/apt.conf.d/80-retries"]
# Bootstrap TLS from Ubuntu's signed archive before using its HTTPS snapshot.
RUN ["apt-get", "update", "--error-on=any"]
RUN ["apt-get", "install", "-y", "--no-install-recommends", "ca-certificates=20240203", "openssl=3.0.13-0ubuntu3"]
COPY ubuntu.sources /etc/apt/sources.list.d/ubuntu.sources
RUN ["apt-get", "update", "--error-on=any"]
# Vulkan loader and lavapipe render without a GPU.
RUN ["apt-get", "install", "-y", "--no-install-recommends", "ca-certificates", "curl", "xz-utils", "pkg-config", "libc6-dev", "libwayland-dev", "libxkbcommon-dev", "libweston-13-dev", "weston", "libvulkan1", "mesa-vulkan-drivers"]
# Checksums from https://nodejs.org/dist/v26.10.0/SHASUMS256.txt.
RUN set -eu; \
    case "$TARGETARCH" in \
        amd64) arch=x64; sha256=ca70e9e349de048b9522abb3adc05b3bd6f43c5ffd3ec57916c7da292f59f022 ;; \
        arm64) arch=arm64; sha256=7a6353f63eb3d04765004b4adf172616243e4522434635cb1d26288658b04ab5 ;; \
        *) echo "unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSLo /tmp/node.tar.xz "https://nodejs.org/dist/v26.10.0/node-v26.10.0-linux-$arch.tar.xz"; \
    echo "$sha256  /tmp/node.tar.xz" | sha256sum -c -; \
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 --wildcards '*/bin' '*/lib' '*/include'; \
    rm /tmp/node.tar.xz; \
    node --version
# Playwright's headless Chromium, with the system libraries it needs from the same
# snapshot.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
RUN npx --yes playwright@1.63.0 install --with-deps --only-shell chromium && \
    rm -rf /root/.npm /var/lib/apt/lists/*
# npm installs of Playwright use the browser above rather than downloading one.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
WORKDIR /work
